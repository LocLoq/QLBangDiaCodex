# Chỉ dùng cho môi trường phát triển; không commit .env có secret.
NORMASTORE_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/normastore_db?charset=utf8mb4
NORMASTORE_TMDB_API_KEY=
NORMASTORE_GEMINI_API_KEY=
NORMASTORE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NORMASTORE_GEMINI_EMBEDDING_DIMENSIONS=768
NORMASTORE_SMTP_HOST=
NORMASTORE_SMTP_PORT=587
NORMASTORE_SMTP_USERNAME=
NORMASTORE_SMTP_FROM=
NORMASTORE_SMTP_STARTTLS=true
